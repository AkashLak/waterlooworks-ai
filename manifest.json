{
  "manifest_version": 3,
  "name": "WatAssistant",
  "version": "2.0.0",
  "description": "AI-powered job analysis for WaterlooWorks co-op students.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "*://waterlooworks.uwaterloo.ca/*",
    "https://waterlooworks-ai-backend-production.up.railway.app/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://waterlooworks.uwaterloo.ca/myAccount/co-op/full/jobs.htm*"
      ],
      "js": ["content/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://waterlooworks.uwaterloo.ca/myAccount/co-op/full/jobs.htm*"
      ],
      "js": [
        "lib/storage.js",
        "lib/scraper.js",
        "lib/analyzer.js",
        "content/renderers.js",
        "content/handlers.js",
        "content/content.js"
      ],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WatAssistant",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "options_page": "options/options.html",

  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src https://waterlooworks-ai-backend-production.up.railway.app; script-src 'self'; style-src 'self' 'unsafe-inline'"
  },

  "web_accessible_resources": [
    {
      "resources": ["lib/pdfjs/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
